---
import { t, contact } from '../data/site.js';
const { lang = 'en' } = Astro.props;
const s = t[lang].contactSec;
const f = s.form;
---
<section id="contact" class="section">
  <div class="wrap">
    <div class="cta">
      <div class="cta__glow" aria-hidden="true"></div>
      <p class="eyebrow mono">{s.eyebrow}</p>
      <h2>{s.h2}</h2>
      <p class="sec-sub">{s.sub}</p>

      {contact.formKey && (
        <form class="cform" action="https://api.web3forms.com/submit" method="POST"
              data-sending={f.sending} data-ok={f.ok} data-err={f.err}>
          <input type="hidden" name="access_key" value={contact.formKey} />
          <input type="hidden" name="subject" value="New message from your portfolio" />
          <input type="checkbox" name="botcheck" class="cform__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="cform__row">
            <label>{f.name}<input type="text" name="name" required autocomplete="name" maxlength="100" /></label>
            <label>{f.email}<input type="email" name="email" required autocomplete="email" maxlength="150" /></label>
          </div>
          <label>{f.message}<textarea name="message" rows="5" required maxlength="4000"></textarea></label>
          <button class="btn btn--primary" type="submit"><svg class="ic"><use href="#i-mail" /></svg> <span>{f.send}</span></button>
          <p class="cform__status" role="status" aria-live="polite"></p>
        </form>
      )}

      {contact.formKey && <p class="cform__or mono">{f.or}</p>}
      <div class="cta__links">
        <a class="btn btn--primary" href={`mailto:${contact.email}`}><svg class="ic"><use href="#i-mail" /></svg> {contact.email}</a>
        <a class="btn btn--ghost" href={contact.linkedin} target="_blank" rel="noopener"><svg class="ic"><use href="#i-in" /></svg> LinkedIn</a>
        <a class="btn btn--ghost" href={contact.github} target="_blank" rel="noopener"><svg class="ic"><use href="#i-gh" /></svg> GitHub</a>
      </div>
    </div>
  </div>
</section>
